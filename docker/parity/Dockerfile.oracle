# PHP oracle image for differential testing against OSPOS 3.4.3.
# Build context is this directory; the upstream tree is mounted read-only as the
# additional build context `oracle` so /home/yash/ospos is never modified.
FROM php:8.5-apache

RUN apt-get update \
    && apt-get install -y --no-install-recommends libicu-dev libpng-dev libzip-dev libonig-dev unzip git \
    && docker-php-ext-install intl bcmath gd mysqli pdo_mysql zip \
    && a2enmod rewrite headers \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

COPY --from=oracle . /var/www/html

COPY apache.conf /etc/apache2/sites-available/000-default.conf
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh \
    && chown -R www-data:www-data /var/www/html

WORKDIR /var/www/html
EXPOSE 80
ENTRYPOINT ["/entrypoint.sh"]
