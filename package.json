{
  "name": "ospos-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate:sqlite": "drizzle-kit generate --config=drizzle.config.sqlite.ts",
    "db:generate:mysql": "drizzle-kit generate --config=drizzle.config.mysql.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.sqlite.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.sqlite.ts",
    "test": "vitest run",
    "test:mysql": "vitest run --config=vitest.mysql.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "parity": "tsx scripts/parity/run-all.ts",
    "parity:schema": "tsx scripts/parity/sqlite-schema.ts",
    "parity:mysql-schema": "tsx scripts/parity/mysql-schema.ts",
    "parity:seed": "tsx scripts/parity/seed.ts",
    "parity:config": "tsx scripts/parity/config-keys.ts",
    "parity:locales": "tsx scripts/parity/locale-keys.ts",
    "import:ospos": "tsx scripts/import-ospos-mysql.ts",
    "export:ospos": "tsx scripts/export-ospos-mysql.ts",
    "port:locales": "tsx scripts/port-locales.ts",
    "e2e:prepare": "tsx e2e/prepare-db.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.2",
    "@react-pdf/renderer": "^4.5.1",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "bwip-js": "^4.11.1",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.2",
    "image-size": "^2.1.0",
    "lucide-react": "^1.22.0",
    "mysql2": "^3.22.5",
    "next": "16.2.9",
    "next-auth": "^5.0.0-beta.31",
    "next-intl": "^4.13.0",
    "nodemailer": "^7.0.13",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.80.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "@parcel/watcher@2.5.6": true,
    "better-sqlite3@12.11.1": true,
    "@swc/core@1.15.43": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
